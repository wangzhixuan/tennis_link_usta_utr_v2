# USTA Credentials (Optional, if needed for secure content)
USTA_USER=your_usta_username_or_email
USTA_PASS=your_usta_password

# UTR Credentials (Highly recommended, as UTR search requires login)
UTR_USER=your_utr_username_or_email
UTR_PASS=your_utr_password

# Database Configuration
DB_PATH=tennislink.db

# Scraping settings
HEADLESS=true

# Playwright persistent browser profile (stores USTA/UTR login cookies).
# Defaults to ~/.tennislink/playwright_profile on a fresh machine.
PLAYWRIGHT_USER_DIR=

# Golden USTA->UTR mapping CSV (used by batch_fetch.py and the matcher).
# Leave blank to use the default sibling-project path
# (<repo parent>/Tennis/data/usta_to_utr_id_mapping.csv).
GOLDEN_MAPPING_PATH=
